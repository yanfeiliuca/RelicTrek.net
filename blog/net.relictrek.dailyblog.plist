<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.relictrek.dailyblog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/yanfeiliu/Documents/GitHub/relictrek.net/blog/run_daily_blog.sh</string>
    </array>

    <!-- Run daily at 3:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Run immediately on login (in case machine was asleep at 3 AM) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/Users/yanfeiliu/Documents/GitHub/relictrek.net/blog/.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yanfeiliu/Documents/GitHub/relictrek.net/blog/.launchd.err.log</string>
</dict>
</plist>
